# Copie este arquivo para .env e ajuste os valores.
# NUNCA suba o .env real para o GitHub (ele está no .gitignore).

# Banco (SQLite por padrão; troque para Postgres em produção)
DATABASE_URL="file:./dev.db"

# Segredo do JWT — gere um valor longo e aleatório.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-isto-por-um-segredo-bem-grande-e-aleatorio"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=4000
CORS_ORIGIN="*"
